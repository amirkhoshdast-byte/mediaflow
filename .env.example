# --- Site ---
# Local dev: ":80" (plain http on HTTP_PORT). Production: your domain (Caddy issues TLS automatically).
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
# Set to true when served over https
COOKIE_SECURE=false

# --- Database / queue ---
POSTGRES_USER=ncr
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=ncr
REDIS_URL=redis://redis:6379/0

# --- Secrets (generate: python -c "import secrets;print(secrets.token_urlsafe(48))") ---
SECRET_KEY=change-me-dev-secret-key-0123456789abcdef0123456789
# Fernet key for TOTP secrets (generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# --- First admin (created at startup if no users exist) ---
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-now

# --- AI gateway: switch providers here, no code change ---
# Providers: anthropic | openai_compatible | ollama
AI_PROVIDER_CLASSIFY=anthropic
AI_PROVIDER_GENERATE=anthropic
# Ollama is optional: start it with `docker compose --profile local-ai up -d`
# Provider used for anything marked "sensitive" (must be local: ollama)
# Embeddings (knowledge base). anthropic has no embeddings API: use ollama or openai_compatible
AI_PROVIDER_EMBED=ollama
AI_PROVIDER_SENSITIVE=ollama

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=bge-m3
